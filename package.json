  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  },
  "license": "MIT"
}
